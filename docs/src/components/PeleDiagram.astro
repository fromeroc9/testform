---
import { render } from 'pele';

interface Props {
  chart: string;
  title?: string;
  caption?: string;
}

const { chart, title, caption } = Astro.props;

let svgHtml = '';
try {
  const res = render(chart.trim());
  svgHtml = res.svg;
} catch (e: any) {
  svgHtml = `<div class="pele-error">Error rendering Pele diagram: ${e?.message || e}</div>`;
}
---

<div class="pele-wrapper">
  {title && <div class="pele-header-title">{title}</div>}
  <div class="pele-svg-container" set:html={svgHtml} />
  {caption && <div class="pele-caption">{caption}</div>}
</div>

<style is:global>
  .pele-wrapper {
    margin: 2.5rem 0;
    padding: 1.5rem;
    border-radius: 1.15rem;
    background: var(--sl-color-bg-inline-code, #090d16);
    border: 1px solid var(--sl-color-hairline, rgba(255, 255, 255, 0.1));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .pele-header-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-accent, #38bdf8);
    margin-bottom: 1rem;
  }
  .pele-svg-container {
    width: 100%;
    display: flex;
    justify-content: center;
    overflow-x: auto;
  }
  .pele-svg-container svg {
    --pele-bg: transparent;
    --pele-fg: var(--sl-color-white, #f8fafc);
    --pele-line: var(--sl-color-accent, #38bdf8);
    --pele-surface: var(--sl-color-gray-6, #0f172a);
    --pele-border: var(--sl-color-gray-5, rgba(255, 255, 255, 0.15));
    --pele-accent: var(--sl-color-accent, #0284c7);
    max-width: 100%;
    height: auto;
  }
  .pele-caption {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3, #94a3b8);
    margin-top: 1rem;
    text-align: center;
  }
</style>
