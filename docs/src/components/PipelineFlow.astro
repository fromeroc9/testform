---
// PipelineFlow.astro - Interactive State Simulation
---

<div class="flow-interactive-wrapper">
  <div class="flow-top-bar">
    <div class="flow-top-title">
      <span class="live-pulse-dot"></span>
      <span>Interactive Pipeline Flow • Test Management as Code (TMaC)</span>
    </div>
  </div>

  <div class="flow-nodes-grid">
    <div class="flow-node-card active" data-step="0">
      <div class="flow-node-header">
        <span class="flow-node-icon">📦</span>
        <span class="flow-node-step">01</span>
      </div>
      <div class="flow-node-title">Git Versioning</div>
      <div class="flow-node-sub">specs/*.case.feature</div>
      <div class="flow-active-indicator"></div>
    </div>

    <div class="flow-node-card" data-step="1">
      <div class="flow-node-header">
        <span class="flow-node-icon">⚡</span>
        <span class="flow-node-step">02</span>
      </div>
      <div class="flow-node-title">testform plan</div>
      <div class="flow-node-sub">DAG Graph & Diff</div>
      <div class="flow-active-indicator"></div>
    </div>

    <div class="flow-node-card" data-step="2">
      <div class="flow-node-header">
        <span class="flow-node-icon">🔒</span>
        <span class="flow-node-step">03</span>
      </div>
      <div class="flow-node-title">State Backend</div>
      <div class="flow-node-sub">GitHub Bucket / S3</div>
      <div class="flow-active-indicator"></div>
    </div>

    <div class="flow-node-card" data-step="3">
      <div class="flow-node-header">
        <span class="flow-node-icon">☁️</span>
        <span class="flow-node-step">04</span>
      </div>
      <div class="flow-node-title">Cloud Reconcile</div>
      <div class="flow-node-sub">GitHub Projects V2</div>
      <div class="flow-active-indicator"></div>
    </div>
  </div>

  <div class="flow-detail-viewport">
    <div class="flow-detail-meta">
      <span class="flow-detail-badge" id="flow-badge">01. SOURCE OF TRUTH</span>
      <h3 class="flow-detail-title" id="flow-title">Git Versioning</h3>
      <p class="flow-detail-desc" id="flow-desc">Casos escritos en Gherkin conviviendo en el mismo repo con el código de tu aplicación.</p>
    </div>
    <div class="flow-detail-code">
      <div class="flow-code-header">
        <span>Terminal / Source Simulation</span>
        <span class="flow-code-dot"></span>
      </div>
      <pre class="flow-code-pre"><code id="flow-code">{`@testcase @smoke
Scenario: OAuth 2.0 Login
  Given url "\${local.login_url}"
  Then status = 200`}</code></pre>
    </div>
  </div>
</div>

<script>
  const STAGES = [
    {
      badge: '01. SOURCE OF TRUTH',
      title: 'Git Versioning',
      desc: 'Casos escritos en Gherkin conviviendo en el mismo repo con el código de tu aplicación.',
      code: '@testcase @smoke\nScenario: OAuth 2.0 Login\n  Given url "${local.login_url}"\n  Then status = 200'
    },
    {
      badge: '02. SPECULATIVE ENGINE',
      title: 'testform plan',
      desc: 'Calcula dependencias topológicas y previsualiza altas (+), cambios (~) y bajas (-) sin tocar producción.',
      code: '$ testform plan\n+ resource "testcase" "auth.case.feature.@tc-01"\nPlan: 1 to add, 0 to change, 0 to destroy.'
    },
    {
      badge: '03. LEDGER & LOCK',
      title: 'State Backend',
      desc: 'GitHub actúa como bucket de almacenamiento seguro con optimistic locking concurrente en la rama testform-state.',
      code: 'Acquiring state lock on github:testform-state... [OK]\nState SHA-256: 7f8a9b2c... verified.\nLock released.'
    },
    {
      badge: '04. RECONCILIATION',
      title: 'GitHub Projects V2',
      desc: 'Conciliación atómica. Si alguien edita en la web, testform diff --remote detecta la discrepancia al instante.',
      code: '$ testform apply -auto-approve\nApply complete! 1 resource reconciled.\nZero drift maintained.'
    }
  ];

  const cards = document.querySelectorAll('.flow-node-card');
  const badgeEl = document.getElementById('flow-badge');
  const titleEl = document.getElementById('flow-title');
  const descEl = document.getElementById('flow-desc');
  const codeEl = document.getElementById('flow-code');

  function setStage(idx: number) {
    cards.forEach((c, i) => {
      c.classList.toggle('active', i === idx);
    });
    const s = STAGES[idx];
    if (badgeEl) badgeEl.textContent = s.badge;
    if (titleEl) titleEl.textContent = s.title;
    if (descEl) descEl.textContent = s.desc;
    if (codeEl) codeEl.textContent = s.code;
  }

  cards.forEach((card, idx) => {
    card.addEventListener('click', () => setStage(idx));
  });

  let current = 0;
  setInterval(() => {
    current = (current + 1) % STAGES.length;
    setStage(current);
  }, 4000);
</script>

<style>
  .flow-interactive-wrapper {
    margin: 3rem 0;
    padding: 1.75rem;
    border-radius: 1.25rem;
    background: var(--sl-color-bg-inline-code, #090d16);
    border: 1px solid var(--sl-color-hairline, rgba(255, 255, 255, 0.1));
    box-shadow: 0 12px 36px -8px rgba(0, 0, 0, 0.4);
  }
  .flow-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .flow-top-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sl-color-accent, #38bdf8);
  }
  .live-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 10px #10b981;
  }
  .flow-nodes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .flow-node-card {
    position: relative;
    padding: 1.15rem;
    border-radius: 0.85rem;
    background: var(--sl-color-gray-6, #0f172a);
    border: 1px solid var(--sl-color-hairline, rgba(255, 255, 255, 0.1));
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .flow-node-card:hover {
    transform: translateY(-2px);
    border-color: var(--sl-color-accent, #38bdf8);
  }
  .flow-node-card.active {
    border-color: var(--sl-color-accent, #38bdf8);
    background: rgba(56, 189, 248, 0.08);
  }
  .flow-node-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .flow-node-icon { font-size: 1.35rem; }
  .flow-node-step { font-family: monospace; font-size: 0.72rem; color: var(--sl-color-gray-3); }
  .flow-node-title { font-size: 0.95rem; font-weight: 750; color: var(--sl-color-white); margin-bottom: 0.2rem; }
  .flow-node-sub { font-size: 0.75rem; color: var(--sl-color-gray-3); font-family: monospace; }
  .flow-active-indicator {
    display: none;
    position: absolute;
    bottom: 0;
    left: 15%;
    right: 15%;
    height: 3px;
    border-radius: 9999px;
    background: var(--sl-color-accent, #38bdf8);
  }
  .flow-node-card.active .flow-active-indicator { display: block; }
  .flow-detail-viewport {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 1.5rem;
    padding: 1.5rem;
    border-radius: 0.85rem;
    background: var(--sl-color-black, #050811);
    border: 1px solid var(--sl-color-hairline, rgba(255, 255, 255, 0.06));
  }
  @media (max-width: 860px) {
    .flow-detail-viewport { grid-template-columns: 1fr; }
  }
  .flow-detail-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 750;
    text-transform: uppercase;
    color: var(--sl-color-accent, #38bdf8);
    margin-bottom: 0.4rem;
  }
  .flow-detail-title { font-size: 1.25rem; font-weight: 800; color: var(--sl-color-white); margin: 0 0 0.5rem; }
  .flow-detail-desc { font-size: 0.88rem; line-height: 1.6; color: var(--sl-color-gray-3); margin: 0; }
  .flow-detail-code {
    border-radius: 0.65rem;
    overflow: hidden;
    background: #090d16;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .flow-code-header {
    display: flex;
    justify-content: space-between;
    padding: 0.45rem 0.85rem;
    background: #0f172a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
    font-family: monospace;
  }
  .flow-code-dot { width: 6px; height: 6px; border-radius: 50%; background: #38bdf8; }
  .flow-code-pre { margin: 0; padding: 0.85rem 1rem; font-family: monospace; font-size: 0.8rem; line-height: 1.6; color: #e2e8f0; overflow-x: auto; }
</style>
