{
	"name": "@fromeroc9/testform",
	"version": "1.0.17",
	"description": "Testform transforms standard issue trackers into full-fledged Test Management ecosystems using declarative Gherkin configurations that can be shared, reviewed, and versioned as code.",
	"author": "Flavio Romero <flavio.arc9@gmail.com>",
	"main": "dist/index.js",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fromeroc9/testform.git"
	},
	"keywords": [
		"test-management",
		"test-as-code",
		"gherkin",
		"bdd",
		"behavior-driven development",
		"github",
		"testform"
	],
	"files": [
		"dist",
		"README.md"
	],
	"bin": {
		"testform": "dist/index.js"
	},
	"scripts": {
		"prebuild": "node -e \"const fs = require('fs'); if (fs.existsSync('dist')) fs.rmSync('dist', { recursive: true, force: true });\"",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "ncc build src/index.ts -m -e @aws-sdk/client-s3 -e @aws-sdk/client-dynamodb -e @azure/storage-blob -e @google-cloud/storage -o dist",
		"dev": "tsx src/index.ts",
		"docs:dev": "npm --prefix docs run dev",
		"docs:build": "npm --prefix docs run build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"publish": "npm run build && npm version patch && npm publish"
	},
	"devDependencies": {
		"@aws-sdk/client-dynamodb": "^3.1152.0",
		"@aws-sdk/client-s3": "^3.1152.0",
		"@azure/storage-blob": "^12.31.0",
		"@google-cloud/storage": "7.19.0",
		"@types/node": "^24.12.4",
		"@vercel/ncc": "0.38.4",
		"prettier": "^3.5.0",
		"tsx": "4.19.3",
		"typescript": "5.8.2",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@cucumber/gherkin": "39.1.0",
		"@cucumber/messages": "30.1.0",
		"cac": "^6.7.14",
		"chalk": "4.1.2",
		"gherkin-ast": "^3.4.2",
		"gherkin-formatter": "^1.2.2",
		"yaml": "^2.9.1"
	},
	"peerDependencies": {
		"@aws-sdk/client-dynamodb": ">=3.0.0",
		"@aws-sdk/client-s3": ">=3.0.0",
		"@azure/storage-blob": ">=12.0.0",
		"@google-cloud/storage": ">=7.0.0"
	},
	"peerDependenciesMeta": {
		"@aws-sdk/client-dynamodb": {
			"optional": true
		},
		"@aws-sdk/client-s3": {
			"optional": true
		},
		"@azure/storage-blob": {
			"optional": true
		},
		"@google-cloud/storage": {
			"optional": true
		}
	},
	"overrides": {
		"undici": "^6.23.0",
		"uuid": "^11.1.1"
	}
}
